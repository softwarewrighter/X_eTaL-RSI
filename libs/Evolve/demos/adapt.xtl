#!/usr/bin/env xetal
## Evolve in use: a harness revising its tools before every batch while
## the recipe shifts from 1 wood to 2 wood a device; the version running
## each batch, its production tokens, and the tools at the end.

"ev:" u_se< "Evolve"
"po:" u_se< "Policy"
"gd:" u_se< "Guardian"
"ws:" u_se< "Workshop"

work := 6 3 3 r_eshape 2 1 1 3 1 1 1 1 1 3 1 1 2 1 1 2 1 1 2 1 1 3 1 1 2 1 1 2 2 1 3 2 1 1 2 1 3 2 1 2 2 1 2 2 1 2 2 1 3 2 1 2 2 1
g := (2 3 r_eshape 2 1 1 2 2 1, 1 2 3 4 5 6 7, 6, 500, 20, 1500, 6)
(fixed, jf, rf) := g ev:e_volve (2 8 3 6 0, (po:n_one 8, 60), work)
(h, j, rep) := g ev:e_volve (2 8 3 6 1, (po:n_one 8, 60), work)
"version running each batch:"
2 s_elect_2 rep
"production tokens each batch, fixed and evolving:"
4 s_elect_2 rf
4 s_elect_2 rep
"tokens in all, fixed then evolving (production, writing, review):"
ev:t_okens rf
ev:t_okens rep
"the length of each tool running at the end:"
(T, b) := gd:a_ctive h
'+ r_/_2 T != 0
