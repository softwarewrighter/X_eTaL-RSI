#!/usr/bin/env xetal
## Policy in use: the fixed harness (group A, no tools) on six tasks,
## one model call of 500 tokens per op, then the same harness given one
## tool, the route that makes a device.

"po:" u_se< "Policy"
"jr:" u_se< "Journal"

tasks := 6 3 r_eshape 1 1 1 3 1 1 2 2 1 4 1 1 2 1 3 5 1 1
(da, ja) := (tasks, po:n_one 6, 0, 500) po:w_orkload 100
"fixed harness: tasks done, ops, model calls, tokens"
da
jr:l_ength ja
po:c_alls ja
jr:t_otal ja
(dc, jc) := (tasks, 1 6 r_eshape 1 2 3 4 5 6, 1, 500) po:w_orkload 100
"with the route as a tool: tasks done, ops, model calls, tokens"
dc
jr:l_ength jc
po:c_alls jc
jr:t_otal jc
