#!/usr/bin/env xetal
## Policy's properties, checked with Check on a workload of six tasks:
## tools change the calls, never the outcome or the ops done.

"po:" u_se< "Policy"
"jr:" u_se< "Journal"
"k:" u_se< "Check"

tasks := 6 3 r_eshape 1 1 1 3 1 1 2 2 1 4 1 1 2 1 3 5 1 1
route := 1 6 r_eshape 1 2 3 4 5 6
wrong := 1 6 r_eshape 1 2 3 4 9 6
(da, ja) := (tasks, po:n_one 6, 0, 500) po:w_orkload 100
(dc, jc) := (tasks, route, 1, 500) po:w_orkload 100
(dw, jw) := (tasks, wrong, 2, 500) po:w_orkload 100
(ta, va, oa, ca, ka) := ja
(tc, vc, oc, cc, kc) := jc
c1 := "the fixed harness finishes every task" k:t_est da k:i_s 6
c2 := "so does the harness with the tool" k:t_est dc k:i_s 6
c3 := "the same ops, in the same order" k:t_est oc k:i_s oa
c4 := "no op fails" k:t_est ('& r_/ kc) k:i_s 1
c5 := "the fixed harness makes one call per op" k:t_est (po:c_alls ja) k:i_s jr:l_ength ja
c6 := "the tool saves 5 calls per device made with it" k:t_est ((po:c_alls ja) - po:c_alls jc) k:i_s 5 * '+ r_/ (1 s_elect_2 tasks) * ((2 s_elect_2 tasks) = 1) & (3 s_elect_2 tasks) = 1
c7 := "a tool that never fits changes nothing" k:t_est (po:c_alls jw) k:i_s po:c_alls ja
((p8, w8, o8, m8, d8), j8) := ((3, 1, 1), po:n_one 6, 1, 0, 500) po:e_pisode 5
c8 := "the budget stops an episode" k:t_est (d8 c_at po:c_alls j8) k:i_s 0 5
k:r_eport c1 k:a_nd c2 k:a_nd c3 k:a_nd c4 k:a_nd c5 k:a_nd c6 k:a_nd c7 k:a_nd c8
