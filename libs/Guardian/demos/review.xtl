#!/usr/bin/env xetal
## Guardian in use: a learned tool table reviewed against the fixed
## harness, layer by layer: the verdict at each depth of review and
## what the review cost.

"gd:" u_se< "Guardian"
"po:" u_se< "Policy"

tasks := 3 3 r_eshape 2 1 1 3 1 1 4 1 1
cand := (1 8 r_eshape 1 2 3 4 5 6 0 0, 60)
on := (po:n_one 8, 60)
"verdict and review tokens, reviewing up to layer 1, 2, ... 6:"
m_ix '{ upto -> (v, c) := (tasks, tasks, tasks, 1 2 3 4 5 6 7, 3, 500, 20, upto) gd:r_eview (cand, on); v c_at c } m_ap 1 2 3 4 5 6
